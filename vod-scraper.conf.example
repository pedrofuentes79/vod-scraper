# vod-scraper configuration — EXAMPLE
#
# Copy to vod-scraper.conf (next to the scripts) or /etc/vod-scraper.conf and fill
# in your values. Sourced as bash by BOTH vod-download.sh and vod-ingest.sh, so use
# plain VAR=value lines (no spaces around =, quote values).
# Lookup order: $VOD_CONFIG, then next to the scripts, then /etc/vod-scraper.conf.

# --- source & download ------------------------------------------------------

# REQUIRED. The newest-first YouTube listings to track, as a bash array. A channel
# splits its long-form uploads across tabs — "/videos" holds uploads, "/streams"
# holds past livestreams, and they don't overlap — so track both to catch everything.
# Playlist URLs work here too. Each listing may also hold shorts, clips and cuts;
# the duration gate below filters those out.
SOURCES=(
  "https://www.youtube.com/@SOME_CHANNEL/videos"
  "https://www.youtube.com/@SOME_CHANNEL/streams"
)

# Where downloads are stored — and where the media server serves them from.
DEST="/home/dietpi/media_store"

# yt-dlp dedup archive. Empty -> $DEST/downloaded.txt.
ARCHIVE=""

MIN_DURATION=3600        # duration gate (s); entries this long or shorter are ignored.
SCAN_DEPTH=50            # newest entries scanned per source.
KEEP_LATEST=14           # recordings kept on disk; older ones rotated out.
MAX_NEW=0                # max downloads per run; 0 -> KEEP_LATEST. Keeps a first run
                         # against a fresh channel from fetching a whole backlog.

# Extra yt-dlp flags applied to every call (listing, metadata read and download).
# "youtube:lang=es" makes YouTube return each video's ORIGINAL title instead of its
# machine translation into the box's locale — without it a Spanish-language channel
# lands in the catalog with English titles.
YTDLP_ARGS=(--extractor-args "youtube:lang=es")

AUDIO_FORMAT="m4a"       # output container. m4a = a lossless copy of YouTube's AAC
                         # track (no re-encode, near-instant on a Pi, iOS-native).

# Optional yt-dlp cookies file (Netscape format). Leave empty for a public source.
# Set only if YouTube starts gating downloads.
COOKIES=""

# All dates/times are evaluated in this timezone regardless of the box clock.
TZ_NAME="UTC"

# --- database (media server) ------------------------------------------------

# The media-server SQLite database that vod-ingest.sh writes rows into. Start the
# media server once first so it creates the DB via its migrations.
DB_PATH="/home/dietpi/media-server/media.db"
