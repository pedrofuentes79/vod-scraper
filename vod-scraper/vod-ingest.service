[Unit]
Description=Register downloaded videos in the media-server DB
After=vod-download.service

[Service]
Type=oneshot
User=dietpi
Group=dietpi
# Idempotent reconciler: scans the media dir and inserts anything not yet in the
# DB. Triggered by vod-download.service's OnSuccess=, and safe to run by hand:
#   sudo systemctl start vod-ingest.service
ExecStart=/usr/local/bin/vod-ingest.sh
